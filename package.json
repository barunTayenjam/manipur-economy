{
  "name": "manipur-economy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Price of Conflict — source-of-truth report on Manipur's conflict economy",
  "scripts": {
    "test": "node tests/unit.test.mjs",
    "lint": "eslint assets/js tests scripts eslint.config.js playwright.config.mjs",
    "lint:fix": "eslint assets/js tests scripts eslint.config.js playwright.config.mjs --fix",
    "format": "prettier --write \"assets/**/*.{js,css}\" \"tests/**/*.{mjs,spec.mjs}\" \"scripts/**/*.mjs\" \"docs/**/*.html\" \"data/**/*.json\" \"index.html\" \"*.mjs\" \"*.js\" \"*.json\"",
    "format:check": "prettier --check \"assets/**/*.{js,css}\" \"tests/**/*.{mjs,spec.mjs}\" \"scripts/**/*.mjs\" \"docs/**/*.html\" \"data/**/*.json\" \"index.html\" \"*.mjs\" \"*.js\" \"*.json\"",
    "test:e2e": "playwright test tests/e2e/smoke.spec.mjs",
    "test:a11y": "playwright test tests/e2e/a11y.spec.mjs",
    "test:visual": "playwright test tests/visual/visual.spec.mjs",
    "test:visual:update": "playwright test tests/visual/visual.spec.mjs --update-snapshots",
    "test:all": "npm run test:e2e && npm run test:a11y",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run test:all && npm run check:seo && npm run check:content",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:content": "node scripts/check-content.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "lhci": "npx -y @lhci/cli@0.14.0 autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
